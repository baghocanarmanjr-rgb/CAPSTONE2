# Local Supabase CLI Postgres (default local DB port 54322)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Change these before deployment.
PSMS_SECRET_KEY=replace-with-a-long-random-secret
PSMS_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-password

# Optional when Tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
